{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WARDLINE India normalized monthly observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "vintage",
    "period",
    "geo_level",
    "geo_id",
    "geo_name",
    "facility_scope",
    "indicator_id",
    "raw_indicator",
    "unit",
    "stratum",
    "value",
    "status",
    "row_locator"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "vintage": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "geo_level": {
      "enum": [
        "national",
        "state_ut",
        "district",
        "subdistrict",
        "facility"
      ]
    },
    "geo_id": {
      "type": "string",
      "minLength": 1
    },
    "geo_name": {
      "type": "string",
      "minLength": 1
    },
    "parent_geo_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "facility_scope": {
      "type": "string",
      "minLength": 1
    },
    "indicator_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_indicator": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "stratum": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": [
        "observed",
        "missing",
        "suppressed",
        "not_reported"
      ]
    },
    "row_locator": {
      "type": "string",
      "minLength": 1
    },
    "publication_status": {
      "enum": [
        "final",
        "provisional",
        "unknown"
      ]
    },
    "mode": {
      "enum": [
        "official",
        "imported_unverified",
        "fixture"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    }
  ]
}
